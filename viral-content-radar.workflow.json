      "parameters": {
        "url": "={{ 'https://api.insightsocial.app/v1/' + ($json.platform === 'TikTok' ? 'tiktok/post/transcript' : 'instagram/media/transcript') }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $json.url }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
