    {
      "parameters": {
        "jsCode": "// The most-viewed picks get their spoken words read. 200 credits each.\nconst base = $input.first().json;\nreturn [...base.picks]\n  .sort((a, b) => (b.views || 0) - (a.views || 0))\n  .slice(0, base.transcripts)\n  .map(v => ({ json: { url: v.url, platform: v.platform, author: v.author, rank: v.rank } }));"
      },
      "id": "8e0363b4-a588-569b-b8e9-d3fa851e4a6e",
      "name": "Pick videos to transcribe",
      "type": "n8n-nodes-base.code",
