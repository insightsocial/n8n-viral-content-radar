      "id": "a3b15894-c1f4-5969-99b5-7ac9906c4af1",
      "name": "Transcript",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "InsightSocial API"
        }
      },
      "retryOnFail": false,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Joins the transcripts (if any) onto the picks and writes the prompt.\nconst base = $('Rank and flag').first().json;\nlet asked = [];\ntry { asked = $('Pick videos to transcribe').all().map(i => i.json); } catch (e) { asked = []; }\n\nfunction clean(vtt) {\n  return String(vtt || '')\n    .replace(/^WEBVTT.*$/m, '')\n    .split('\\n')\n    .filter(l => l.trim() && !/-->/.test(l) && !/^\\d+$/.test(l.trim()))\n    .join(' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nconst transcripts = [];\nlet credits = base.credits_used;\n$input.all().forEach((item, i) => {\n  const d = item.json && item.json.data;\n  if (!d || !asked[i]) return;\n  credits += item.json.credits_used || 0;\n  const text = d.transcript ? clean(d.transcript)\n    : (d.transcripts || []).map(t => t.text || '').join(' ').trim();\n  if (text) transcripts.push({ rank: asked[i].rank, author: asked[i].author, text: Array.from(text).slice(0, 2500).join('') });\n});\n\nconst t = transcripts.map(x => `#${x.rank} @${x.author} said:\\n\"${x.text}\"`).join('\\n\\n');\nconst prompt = `My business: ${base.business}\\nNiche: ${base.niche}\\n\\nThis week's most-viewed short videos in this niche:\\n\\n${base.videos_text}` +\n  (t ? `\\n\\nWhat the top videos actually say (transcripts):\\n\\n${t}` : '');\n\nreturn [{ json: { ...base, transcripts_read: transcripts.length, credits_used: credits, prompt } }];"
      },
      "id": "7444301b-155e-5036-9c7b-ace5ae4aac2a",
      "name": "Attach transcripts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        200
      ]
