      "id": "bfb79987-4c35-5d55-ad98-c8a42907d3cc",
      "name": "Instagram: top Reels",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "InsightSocial API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Turns the two searches into one short list of picks.\n// Nothing here costs credits: it only reads what the two calls above returned.\nconst cfg = $('Your niche').first().json;\nconst tk = $('TikTok: top this week').first().json;\nconst ig = $('Instagram: top Reels').first().json;\nconst tkRows = (tk.data && tk.data.items) || [];\nconst igRows = (ig.data && ig.data.items) || [];\n\n// \"Comment PREP for the recipe\" reels collect comments on purpose (an auto-DM\n// sends the link), so their comment count measures the funnel, not the content.\nconst QUOTED = /\\b(?:comment|dm|type)\\b\\s+(?:the word\\s+)?[\"“”'‘’]\\s*\\w{2,20}\\s*[\"“”'‘’]/i;\nconst CAPS = /\\b(?:[Cc]omment|COMMENT|DM|[Tt]ype)\\s+(?:the word\\s+)?[A-Z]{2,15}\\b/;\nconst AD = /#(?:ad|sponsored|partner)\\b|paid partnership/i;\n\n// Cuts by character, not UTF-16 unit, so an emoji is never split in half.\nconst cut = (s, n) => Array.from(s).slice(0, n).join('');\n\nfunction pick(row, platform) {\n  const p = row.post || {};\n  const e = p.engagement || {};\n  const text = (p.content && p.content.text) || '';\n  const views = e.views == null ? null : Number(e.views);\n  return {\n    platform,\n    author: (p.author && p.author.username) || '',\n    url: p.url || '',\n    caption: cut(text.replace(/\\s+/g, ' ').trim(), 280),\n    views,\n    likes: e.likes == null ? null : Number(e.likes),\n    comments: e.comments == null ? null : Number(e.comments),\n    shares: e.shares == null ? null : Number(e.shares),\n    saves: e.saves == null ? null : Number(e.saves),\n    save_rate: views && e.saves != null ? Math.round((e.saves / views) * 10000) / 100 : null,\n    published_at: p.published_at || null,\n    country: (p.ext && p.ext.region) || null,\n    comment_funnel: QUOTED.test(text) || CAPS.test(text),\n    ad: AD.test(text),\n  };\n}\n\n// Instagram hashtags have no country filter, so keep rows in your language instead.\n// A row whose language could not be told is kept.\nconst lang = String(cfg.language || '').trim().toLowerCase();\nconst inLanguage = r => !lang || !(r.computed && r.computed.language) || r.computed.language === lang;\n\nconst byViews = (a, b) => (b.views || 0) - (a.views || 0);\nconst tiktok = tkRows.filter(inLanguage).map(r => pick(r, 'TikTok')).sort(byViews).slice(0, Number(cfg.top_tiktok) || 5);\nconst reels = igRows.filter(inLanguage).map(r => pick(r, 'Instagram')).sort(byViews).slice(0, Number(cfg.top_reels) || 5);\nconst picks = [...tiktok, ...reels].map((v, i) => ({ rank: i + 1, ...v }));\n\nconst fmt = n => (n == null ? 'hidden' : Number(n).toLocaleString('en-US'));\nconst lines = picks.map(v => {\n  const flags = [v.comment_funnel ? 'COMMENT-FOR-LINK FUNNEL' : '', v.ad ? 'PAID AD' : ''].filter(Boolean).join(', ');\n  return `${v.rank}. [${v.platform}] @${v.author} - ${fmt(v.views)} views, ${fmt(v.likes)} likes, ${fmt(v.comments)} comments` +\n    (v.saves != null ? `, ${fmt(v.saves)} saves` : '') + (flags ? `  (${flags})` : '') +\n    `\\n   Posted: ${v.published_at || 'unknown'}${v.country ? ' from ' + v.country : ''}` +\n    `\\n   Caption: ${v.caption}\\n   URL: ${v.url}`;\n});\n\nreturn [{ json: {\n  business: cfg.business,\n  niche: cfg.niche,\n  hashtag: cfg.hashtag,\n  generated_at: $now.toISO(),\n  transcripts: Math.max(0, Math.min(3, Number(cfg.transcripts) || 0)),\n  credits_used: (tk.credits_used || 0) + (ig.credits_used || 0),\n  found: { tiktok: tkRows.length, instagram: igRows.length },\n  other_language: { tiktok: tkRows.length - tkRows.filter(inLanguage).length, instagram: igRows.length - igRows.filter(inLanguage).length },\n  picks,\n  videos_text: lines.join('\\n\\n'),\n} }];"
      },
